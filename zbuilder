FROM --platform=$BUILDPLATFORM node:24-bookworm AS builder

WORKDIR /app

ENV CI=true \
    NODE_OPTIONS=--max-old-space-size=4096 \
    DOCS_TYPECHECK=warn

RUN corepack enable pnpm

COPY . .

WORKDIR /app/docs

RUN pnpm install --frozen-lockfile

WORKDIR /app/website

RUN pnpm install --frozen-lockfile

RUN pnpm run fetch-docs --force

RUN pnpm run build && cp _redirects build/

FROM ikxin/caddy:latest

COPY --from=builder /app/website/build /usr/share/caddy

EXPOSE 8080
